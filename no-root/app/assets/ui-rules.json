    {
      "id": "com.xiaomi.vipaccount",
      "name": "小米社区",
      "groups": [
        {
          "key": 1,
          "name": "开屏广告-跳过控件",
          "activityIds": ["com.xiaomi.mi.launch.process.OpenScreenActivity"],
          "matchTime": 8000,
          "actionMaximum": 1,
          "rules": [
            {
              "action": "clickNode",
              "anyMatches": ["[id=\"com.xiaomi.vipaccount:id/tv_skip\"][clickable=true]"]
            },
            {
              "action": "clickNode",
              "matches": "[id=\"com.xiaomi.vipaccount:id/iv_open_screen\"]",
              "anyMatches": ["[text^=\"跳过\"][text!*=\"详情\"][text.length<12][clickable=true]"]
            }
          ]
        }
      ]
    },
    {
      "id": "com.xiaomi.shop",
      "name": "小米商城",
      "groups": [
        {
          "key": 1,
          "name": "开屏广告-跳过控件",
          "activityIds": ["com.xiaomi.shop.activity.MainTabActivity"],
          "matchTime": 8000,
          "actionMaximum": 1,
          "rules": [
            {
              "action": "clickNode",
              "matches": "[vid=\"bg_splash_logo\"]",
              "anyMatches": ["[id=\"com.xiaomi.shop:id/skip\"][clickable=true]", "[text^=\"跳过\"][text!*=\"立即查看\"][text.length<12][clickable=true]"]
            }
          ]
        }
      ]
    }
