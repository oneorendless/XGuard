              "anyMatches": [
                "[text*=\"跳过\" || desc*=\"跳过\"][text.length<12][desc.length<12][visibleToUser=true]",
                "[vid=\"tt_splash_skip_btn\" || vid=\"ksad_splash_skip_left_view\" || vid=\"ksad_splash_skip_right_view\"][visibleToUser=true]"
