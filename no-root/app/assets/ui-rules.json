{
  "id": 9001,
  "name": "XGuard 本地补充",
  "version": 2,
  "author": "Xuan",
  "apps": [
    {
      "id": "com.chaoxing.mobile",
      "name": "学习通",
      "groups": [
        {
          "key": 1,
          "name": "开屏广告-跳过控件",
          "matchTime": 18000,
          "actionMaximum": 2,
          "actionCd": 900,
          "rules": [
            {
              "action": "click",
              "anyMatches": [
                "[text*=\"跳过\" || desc*=\"跳过\"][text.length<12][desc.length<12][visibleToUser=true]",
                "[vid=\"tt_splash_skip_btn\" || vid=\"ksad_splash_skip_left_view\" || vid=\"ksad_splash_skip_right_view\"][visibleToUser=true]"
              ]
            }
          ]
        }
      ]
    },
    {
